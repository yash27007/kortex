### **3. Gamification System**

```typescript
// Optimistic XP update
'use client'
function LessonComplete({ lessonId }: Props) {
  const utils = api.useUtils()
  
  const mutation = api.user.addXP.useMutation({
    onMutate: async (variables) => {
      // Cancel outgoing fetches
      await utils.user.getProfile.cancel()
      
      // Snapshot previous value
      const previousData = utils.user.getProfile.getData()
      
      // Optimistically update
      utils.user.getProfile.setData(undefined, (old) => ({
        ...old!,
        xp: old!.xp + variables.amount,
        level: calculateLevel(old!.xp + variables.amount)
      }))
      
      return { previousData }
    },
    onError: (err, variables, context) => {
      // Rollback on error
      utils.user.getProfile.setData(undefined, context?.previousData)
    },
    onSettled: () => {
      utils.user.getProfile.invalidate()
    }
  })
  
  return (
    <motion.button
      whileTap={{ scale: 0.95 }}
      onClick={() => mutation.mutate({ lessonId, amount: 100 })}
      className="btn-primary"
    >
      Complete Lesson
    </motion.button>
  )
}
```

