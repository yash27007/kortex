## 🎯 Kortex-Specific Workflows

### **1. Course Generation Pipeline**

**Flow**: User Request → Inngest → FastAPI → Database → MDX → Frontend

```typescript
// apps/web - Trigger generation
'use server'
export async function triggerCourseGeneration(input: CourseInput) {
  const { userId } = await auth()
  
  await inngest.send({
    name: 'course/generate',
    data: {
      userId,
      title: input.title,
      level: input.level,
      topics: input.topics
    }
  })
  
  return { status: 'processing' }
}
```

```python
# apps/core - Process generation with streaming
from fastapi import FastAPI
from fastapi.responses import StreamingResponse
import asyncio

@app.post("/api/agent/generate")
async def generate_course(input: CourseGenerationInput):
    async def event_stream():
        yield f"data: {json.dumps({'step': 'analyzing', 'message': 'Analyzing topic...'})}\n\n"
        
        # 1. Use Gemini to generate structure
        structure = await gemini_client.generate_structure(input)
        yield f"data: {json.dumps({'step': 'structure', 'progress': 33})}\n\n"
        
        # 2. Save to database
        course_id = await save_to_database(structure)
        yield f"data: {json.dumps({'step': 'database', 'progress': 66})}\n\n"
        
        # 3. Generate MDX content
        for lesson in structure.lessons:
            mdx = await generate_mdx(lesson)
            await save_lesson(course_id, lesson.id, mdx)
        
        yield f"data: {json.dumps({'step': 'complete', 'progress': 100, 'courseId': course_id})}\n\n"
    
    return StreamingResponse(event_stream(), media_type="text/event-stream")
```

