## 🎨 Design & Animation Guidelines

### **Landing Page Philosophy**
- **"Wow Factor" First**: Modern users expect visually engaging experiences
- **Default to Bold**: Vibrant gradients, 3D elements, bold typography over conservative
- **Animations Everywhere**: Subtle movements dramatically improve engagement
- **Dark Mode Priority**: Modern aesthetic with glassmorphism effects
- **Accessibility**: Proper contrast, semantic markup, respect `prefers-reduced-motion`

### **GSAP for Landing Pages**
- Scroll-triggered animations (ScrollTrigger)
- Parallax effects
- Text reveals with SplitText
- Complex timelines
- Pin elements during scroll
- Smooth scrolling (ScrollSmoother)

### **Motion for UI Components**
- Page transitions
- Modal animations
- Hover/tap interactions
- Layout animations
- List item stagger effects
- Drag-and-drop interfaces

### **AI Progress Visualization** (Like ChatGPT/Claude)
Create animated progress logs when AI is generating courses:

```typescript
'use client'
import { motion, AnimatePresence } from 'motion/react'
import { useState, useEffect } from 'react'

type ProgressStep = {
  id: string
  message: string
  status: 'pending' | 'active' | 'complete' | 'error'
}

function AIProgressVisualization() {
  const [steps, setSteps] = useState<ProgressStep[]>([])
  
  // Subscribe to AI generation events
  useEffect(() => {
    const eventSource = new EventSource('/api/generate/stream')
    
    eventSource.onmessage = (event) => {
      const data = JSON.parse(event.data)
      setSteps(prev => [...prev, {
        id: data.id,
        message: data.message,
        status: 'active'
      }])
    }
    
    return () => eventSource.close()
  }, [])
  
  return (
    <div className="space-y-2">
      <AnimatePresence mode="popLayout">
        {steps.map((step, index) => (
          <motion.div
            key={step.id}
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            exit={{ opacity: 0, height: 0 }}
            transition={{ duration: 0.3, delay: index * 0.1 }}
            className="flex items-center gap-3 p-4 bg-muted rounded-lg"
          >
            <motion.div
              animate={{
                rotate: step.status === 'active' ? 360 : 0,
                scale: step.status === 'complete' ? [1, 1.2, 1] : 1
              }}
              transition={{
                rotate: { duration: 1, repeat: Infinity, ease: 'linear' },
                scale: { duration: 0.3 }
              }}
              className="w-5 h-5"
            >
              {step.status === 'active' && <Loader className="animate-spin" />}
              {step.status === 'complete' && <Check className="text-green-500" />}
              {step.status === 'error' && <X className="text-red-500" />}
            </motion.div>
            
            <motion.p
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="text-sm"
            >
              {step.message}
            </motion.p>
          </motion.div>
        ))}
      </AnimatePresence>
    </div>
  )
}
```

### **Streaming AI Responses**
```typescript
// app/api/generate/stream/route.ts
export async function POST(req: Request) {
  const { courseTitle } = await req.json()
  
  const encoder = new TextEncoder()
  const stream = new ReadableStream({
    async start(controller) {
      // Step 1: Analyzing topic
      controller.enqueue(encoder.encode(
        `data: ${JSON.stringify({ id: '1', message: '🔍 Analyzing topic...', status: 'active' })}\n\n`
      ))
      await delay(1000)
      
      // Step 2: Generating curriculum
      controller.enqueue(encoder.encode(
        `data: ${JSON.stringify({ id: '2', message: '📚 Generating curriculum structure...', status: 'active' })}\n\n`
      ))
      await delay(2000)
      
      // Step 3: Creating lessons
      controller.enqueue(encoder.encode(
        `data: ${JSON.stringify({ id: '3', message: '✍️ Writing lesson content...', status: 'active' })}\n\n`
      ))
      
      controller.close()
    }
  })
  
  return new Response(stream, {
    headers: {
      'Content-Type': 'text/event-stream',
      'Cache-Control': 'no-cache',
      'Connection': 'keep-alive'
    }
  })
}
```

