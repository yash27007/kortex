## 📧 Email Scheduling System

### **Stack**
- **Email Service**: Resend or SendGrid
- **Scheduler**: Inngest or BullMQ
- **AI Content**: Gemini for personalized email generation

### **Implementation**:
```typescript
// lib/inngest/functions/schedule-reminder.ts
import { inngest } from '../client'
import { db } from '@kortex/db'

export const scheduleDailyReminder = inngest.createFunction(
  { id: 'schedule-daily-reminder', name: 'Schedule Daily Study Reminder' },
  { cron: '0 9 * * *' }, // Every day at 9 AM
  async ({ step }) => {
    const users = await step.run('fetch-active-users', async () => {
      return db.user.findMany({
        where: {
          emailPreferences: { studyReminders: true }
        },
        include: { enrollments: { include: { course: true } } }
      })
    })
    
    for (const user of users) {
      await step.run(`send-reminder-${user.id}`, async () => {
        const emailContent = await generatePersonalizedEmail(user)
        await sendEmail({
          to: user.email,
          subject: '🎓 Your daily learning awaits!',
          html: emailContent
        })
      })
    }
  }
)

async function generatePersonalizedEmail(user: User) {
  // Use Gemini to generate personalized content
  const prompt = `Generate a motivational study reminder for ${user.name}...`
  const response = await gemini.generateContent(prompt)
  return response.text()
}
```

