# Root .env — only read by `docker compose` (for Inngest Cloud credentials).
# Both are optional for local dev: the Inngest dev server (started by
# docker-compose.yml) needs neither.
#
# Everything else — Gemini/Tavily keys, the database URL, Clerk keys — lives
# in each service's own .env, NOT here. See:
#   apps/core/.env.example
#   apps/web/.env.example
#   packages/db/.env.example

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
