# Kortex AI Core (apps/core) — copy to apps/core/.env and fill in.

# App
APP_NAME=Kortex AI Core
DEBUG=true

# Google Gemini — https://aistudio.google.com/apikey
# NOTE: as of 2026-08, the Gemini 2.5 line and text-embedding-004 both 404
# ("no longer available to new users") on freshly created API keys. The
# values below are the models confirmed working against a new key; check
# https://ai.google.dev/gemini-api/docs/models before changing them.
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-3.6-flash
GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Tavily — web research during course generation. https://tavily.com
# (Also accepts TAVILY_API_KEY as an alias.)
TAVILY_KEY=

# Qdrant vector database — defaults match docker-compose.yml
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# Redis cache — defaults match docker-compose.yml
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Chunking for the RAG pipeline
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Inngest — the local dev server (docker-compose.yml) needs none of this.
# Required only when targeting Inngest Cloud instead of the dev server.
INNGEST_DEV=true
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Internal service-to-service auth: apps/core calls back into apps/web to
# persist generated content. This must match INTERNAL_API_SECRET in
# apps/web/.env — pick any random string and use the same value in both.
INTERNAL_API_SECRET=
NEXTJS_API_URL=http://localhost:3000

# Optional — Supabase Storage (S3-compatible), only used by the file-upload
# feature (PDF/document materials for course generation). Supabase Dashboard
# > Project Settings > Storage > S3 Access Keys.
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_ENDPOINT=
S3_REGION=us-east-1

# Optional — not currently used by any code path.
FIRECRAWL_API_KEY=
