# Kortex web app (apps/web) — copy to apps/web/.env.local and fill in.

# Postgres, via the packages/db Prisma schema — same value as
# packages/db/.env. Defaults match docker-compose.yml.
DATABASE_URL=postgresql://kortex:kortex_dev_password@localhost:5433/kortex_dev

# Clerk (learner authentication) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Clerk webhook — Dashboard > Webhooks. Only needed if you've registered a
# public HTTPS endpoint for user sync; in local dev, getOrCreateUser()
# (lib/get-or-create-user.ts) provisions users lazily instead, so this can
# be left blank.
CLERK_WEBHOOK_SECRET=

# apps/core's base URL. Both default to http://localhost:8000 if unset —
# only set these if apps/core runs somewhere else. (Two names because two
# different routes historically picked different ones; both are read.)
CORE_API_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

# Internal service-to-service auth: must match INTERNAL_API_SECRET in
# apps/core/.env — pick any random string and use the same value in both.
INTERNAL_API_SECRET=

# Admin login (separate from Clerk — a single shared admin account, not a
# Clerk user). If unset, development falls back to a documented insecure
# default (admin@kortex.com / admin123); production refuses to start
# without these set. See lib/admin-auth.ts.
ADMIN_EMAIL=admin@kortex.com
ADMIN_PASSWORD=admin123
ADMIN_SECRET=
