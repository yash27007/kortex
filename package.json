{
  "name": "kortex",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@kortex/web",
    "dev:core": "turbo run dev --filter=@kortex/core",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
